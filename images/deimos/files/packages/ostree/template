# Template file for 'ostree'
pkgname=ostree
version=2026.4
revision=1
build_style=gnu-configure
build_helper="gir"
configure_args="--without-libsystemd --with-dracut=yes --with-composefs --with-curl --with-openssl --with-ed25519-libsodium --with-modern-grub --disable-static --enable-experimental-api --with-grub2-mkconfig-path=/usr/bin/grub-mkconfig" 
hostmakedepends="bison docbook-xsl composefs glib-devel libxslt pkg-config"
makedepends="e2fsprogs-devel libcomposefs-devel fuse-devel glib-devel gpgme-devel libarchive-devel
 libcurl-devel libsodium-devel $(vopt_if gir 'gobject-introspection') libsoup3-devel"
checkdepends="attr-progs cpio elfutils gnupg python3-yaml tar which xz jq"
short_desc="Operating system and container binary deployment and upgrades"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="LGPL-2.0-or-later"
homepage="https://ostreedev.github.io/ostree/"
changelog="https://github.com/ostreedev/ostree/releases"
distfiles="https://github.com/ostreedev/ostree/releases/download/v${version}/libostree-${version}.tar.xz"
checksum=b26c9016eb03bb4ee52cc00c642d56e00fc79ae7faac6bf4aa317d7451339ef7

build_options="gir"
build_options_default="gir"

post_install() {
	vcompletion bash/ostree bash
}

libostree_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - transitional dummy package"
	metapackage=yes
}

libostree-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} libglib-devel liblzma-devel
	 libcurl-devel gpgme-devel libsodium-devel libarchive-devel zlib-devel
	 openssl-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
		fi
	}
}