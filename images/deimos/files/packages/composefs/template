composefs_package() {
    pkg_install() {
        vmove usr/bin
    }
}

libcomposefs_package() {
    short_desc+=" - shared library"
    pkg_install() {
        vmove "usr/lib/*.so.*"
    }
}

libcomposefs-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}
	 openssl-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
	}
}